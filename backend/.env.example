PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/sweety_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5177
COOKIE_SECURE=false
# Optional (defaults shown)
APP_TIMEZONE=Asia/Kolkata
BCRYPT_ROUNDS=12
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional; set only when Redis requires authentication.
REDIS_PASSWORD=
