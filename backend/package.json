{
  "name": "sweety-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sweety - Blood Glucose Tracker API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node migrations/run.js",
    "migrate:test": "cross-env NODE_ENV=test node migrations/run.js",
    "seed": "node seeds/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageDirectory": "coverage"
  }
}
